{% doc %}
  @prompt
    Build a Shopify product information section for a luxury nail/beauty product called "Polymer gel | Sesk OR | UV/LED" using the following design and layout. The section must be a dark, premium Shopify section with custom Liquid + CSS (no external frameworks).
    
    Product data to display:
    
    Badge: "BEST SELLER" (capsule pill, dark teal background #1A5470, text #B5D2E0)
    Title: "Polymer gel | Sesk OR | UV/LED"
    Star rating: 5 gold stars + "4.9" + "(163 Reviews)"
    Price: strikethrough compare-at $64.80, sale price $32.40 (large white text)
    Color selector: heading "Choose Color (200 available)"
    Color tabs: All, Reds (20), Pinks (20), Nudes (20), Purples (20), Blues (20)
    Color swatches: circular 32px swatches, selected state shows a white inner dot, include a "SHOW ALL" link
    Quantity selector: minus / number / plus inside a bordered box
    "Add to Cart" button: wide, uppercase, bold, background #AFC1CA, text #030407, hover #ffffff
    Wishlist/heart icon button
    Collapsible information blocks:
    
    Features — two-column list of icons + text:
    Cure Time: 60 seconds
    Requires 1-2 Thin Coats
    Size: 15ML (0.5 oz)
    Highly Pigmented Formula
    Fast Soak-Off Removal
    Details — paragraph description + disclaimer note about color variation
    Design requirements:
    
    Background: #04060B
    Body text: #AFC1CA
    Headings/price: #ffffff
    Font: Montserrat
    Section max-width: 1232px, centered
    Responsive: stacked on mobile, two-column on desktop (image left 49%, info right 49%)
    CSS-only collapsible accordion with plus/cross icon animation
    Use Shopify section settings and blocks so the merchant can edit badge, title, price, features, details, and swatches from the theme editor
{% enddoc %}
```liquid
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');

  .ai-luxury-product-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.body_text_color }};
    font-family: 'Montserrat', sans-serif;
    padding: 60px 20px;
  }

  .ai-luxury-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .ai-luxury-product-container-{{ ai_gen_id }} {
      grid-template-columns: 49% 49%;
      gap: 2%;
    }
  }

  .ai-luxury-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .ai-luxury-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-luxury-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    width: fit-content;
  }

  .ai-luxury-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  .ai-luxury-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .ai-luxury-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    color: #FFD700;
  }

  .ai-luxury-rating-text-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-weight: 600;
  }

  .ai-luxury-reviews-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    opacity: 0.7;
  }

  .ai-luxury-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-luxury-compare-price-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-size: 20px;
    text-decoration: line-through;
    opacity: 0.5;
  }

  .ai-luxury-sale-price-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 36px;
    font-weight: 700;
  }

  .ai-luxury-color-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-luxury-color-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }

  .ai-luxury-color-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-luxury-color-tab-{{ ai_gen_id }} {
    background: transparent;
    border: 1px solid {{ block.settings.body_text_color }};
    color: {{ block.settings.body_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-luxury-color-tab-{{ ai_gen_id }}:hover,
  .ai-luxury-color-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.heading_color }};
    color: {{ block.settings.background_color }};
    border-color: {{ block.settings.heading_color }};
  }

  .ai-luxury-swatches-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .ai-luxury-swatch-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
  }

  .ai-luxury-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-luxury-swatch-{{ ai_gen_id }}.selected::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    background-color: {{ block.settings.heading_color }};
    border-radius: 50%;
  }

  .ai-luxury-show-all-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .ai-luxury-actions-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-luxury-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 1px solid {{ block.settings.body_text_color }};
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-luxury-qty-btn-{{ ai_gen_id }} {
    background: transparent;
    border: none;
    color: {{ block.settings.body_text_color }};
    width: 40px;
    height: 48px;
    cursor: pointer;
    font-size: 18px;
    transition: background 0.3s ease;
  }

  .ai-luxury-qty-btn-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .ai-luxury-qty-input-{{ ai_gen_id }} {
    background: transparent;
    border: none;
    color: {{ block.settings.heading_color }};
    width: 50px;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
  }

  .ai-luxury-add-to-cart-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 16px 32px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.3s ease;
  }

  .ai-luxury-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-luxury-wishlist-{{ ai_gen_id }} {
    background: transparent;
    border: 1px solid {{ block.settings.body_text_color }};
    color: {{ block.settings.body_text_color }};
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .ai-luxury-wishlist-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .ai-luxury-accordion-{{ ai_gen_id }} {
    border-top: 1px solid rgba(175, 193, 202, 0.2);
  }

  .ai-luxury-accordion-item-{{ ai_gen_id }} {
    border-bottom: 1px solid rgba(175, 193, 202, 0.2);
  }

  .ai-luxury-accordion-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
  }

  .ai-luxury-accordion-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 600;
    margin: 0;
  }

  .ai-luxury-accordion-icon-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-size: 20px;
    transition: transform 0.3s ease;
  }

  .ai-luxury-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-luxury-accordion-content-{{ ai_gen_id }}.open {
    max-height: 1000px;
    padding-bottom: 20px;
  }

  .ai-luxury-accordion-icon-{{ ai_gen_id }}.open {
    transform: rotate(45deg);
  }

  .ai-luxury-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    color: {{ block.settings.body_text_color }};
  }

  .ai-luxury-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
  }

  .ai-luxury-feature-icon-{{ ai_gen_id }} {
    margin-top: 2px;
  }

  .ai-luxury-details-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-luxury-disclaimer-{{ ai_gen_id }} {
