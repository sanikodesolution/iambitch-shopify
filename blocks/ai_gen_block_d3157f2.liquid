{% endstyle %}

<luxury-product-{{ ai_gen_id }} class="ai-luxury-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-product-container-{{ ai_gen_id }}">
    <div class="ai-luxury-product-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 1000 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          class="ai-luxury-product-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
        >
      {% else %}
        <div style="background: #1a1a1a; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-product-info-{{ ai_gen_id }}">
      {% if block.settings.show_badge %}
        <span class="ai-luxury-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
      {% endif %}

      <h1 class="ai-luxury-title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h1>

      {% if block.settings.show_rating %}
        <div class="ai-luxury-rating-{{ ai_gen_id }}">
          <div class="ai-luxury-stars-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </div>
          <span class="ai-luxury-rating-text-{{ ai_gen_id }}">{{ block.settings.rating_value }}</span>
          <span class="ai-luxury-reviews-{{ ai_gen_id }}">({{ block.settings.review_count }} Reviews)</span>
        </div>
      {% endif %}

      <div class="ai-luxury-price-{{ ai_gen_id }}">
        {% if block.settings.compare_price %}
          <span class="ai-luxury-compare-price-{{ ai_gen_id }}">${{ block.settings.compare_price }}</span>
        {% endif %}
        <span class="ai-luxury-sale-price-{{ ai_gen_id }}">${{ block.settings.sale_price }}</span>
      </div>

      <div class="ai-luxury-color-section-{{ ai_gen_id }}">
        <h3 class="ai-luxury-color-heading-{{ ai_gen_id }}">{{ block.settings.color_heading }}</h3>
        
        <div class="ai-luxury-color-tabs-{{ ai_gen_id }}">
          <button class="ai-luxury-color-tab-{{ ai_gen_id }} active" data-category="all">All</button>
          <button class="ai-luxury-color-tab-{{ ai_gen_id }}" data-category="reds">Reds (20)</button>
          <button class="ai-luxury-color-tab-{{ ai_gen_id }}" data-category="pinks">Pinks (20)</button>
          <button class="ai-luxury-color-tab-{{ ai_gen_id }}" data-category="nudes">Nudes (20)</button>
          <button class="ai-luxury-color-tab-{{ ai_gen_id }}" data-category="purples">Purples (20)</button>
          <button class="ai-luxury-color-tab-{{ ai_gen_id }}" data-category="blues">Blues (20)</button>
        </div>

        <div class="ai-luxury-swatches-{{ ai_gen_id }}">
          {% for i in (1..12) %}
            {% assign hue = i | times: 30 %}
            <button 
              class="ai-luxury-swatch-{{ ai_gen_id }} {% if i == 1 %}selected{% endif %}"
              style="background-color: hsl({{ hue }}, 70%, 50%);"
              aria-label="Color {{ i }}"
            ></button>
          {% endfor %}
          <button class="ai-luxury-show-all-{{ ai_gen_id }}">SHOW ALL</button>
        </div>
      </div>

      <div class="ai-luxury-actions-{{ ai_gen_id }}">
        <div class="ai-luxury-quantity-{{ ai_gen_id }}">
          <button class="ai-luxury-qty-btn-{{ ai_gen_id }}" data-action="decrease" aria-label="Decrease quantity">−</button>
          <input type="number" class="ai-luxury-qty-input-{{ ai_gen_id }}" value="1" min="1" readonly>
          <button class="ai-luxury-qty-btn-{{ ai_gen_id }}" data-action="increase" aria-label="Increase quantity">+</button>
        </div>
        <button class="ai-luxury-add-to-cart-{{ ai_gen_id }}">Add to Cart</button>
        <button class="ai-luxury-wishlist-{{ ai_gen_id }}" aria-label="Add to wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>
      </div>

      <div class="ai-luxury-accordion-{{ ai_gen_id }}">
        <div class="ai-luxury-accordion-item-{{ ai_gen_id }}">
          <button class="ai-luxury-accordion-header-{{ ai_gen_id }}" data-accordion="features">
            <h3 class="ai-luxury-accordion-title-{{ ai_gen_id }}">Features</h3>
            <span class="ai-luxury-accordion-icon-{{ ai_gen_id }}">+</span>
          </button>
          <div class="ai-luxury-accordion-content-{{ ai_gen_id }}">
            <div class="ai-luxury-features-grid-{{ ai_gen_id }}">
              <div class="ai-luxury-feature-{{ ai_gen_id }}">
                <span class="ai-luxury-feature-icon-{{ ai_gen_id }}">⏱</span>
                <span>Cure Time: 60 seconds</span>
              </div>
              <div class="ai-luxury-feature-{{ ai_gen_id }}">
                <span class="ai-luxury-feature-icon-{{ ai_gen_id }}">✓</span>
                <span>Requires 1-2 Thin Coats</span>
              </div>
              <div class="ai-luxury-feature-{{ ai_gen_id }}">
                <span class="ai-luxury-feature-icon-{{ ai_gen_id }}">📏</span>
                <span>Size: 15ML (0.5 oz)</span>
              </div>
              <div class="ai-luxury-feature-{{ ai_gen_id }}">
                <span class="ai-luxury-feature-icon-{{ ai_gen_id }}">💎</span>
                <span>Highly Pigmented Formula</span>
              </div>
              <div class="ai-luxury-feature-{{ ai_gen_id }}">
                <span class="ai-luxury-feature-icon-{{ ai_gen_id }}">🧪</span>
                <span>Fast Soak-Off Removal</span>
              </div>
            </div>
          </div>
        </div>

        <div class="ai-luxury-accordion-item-{{ ai_gen_id }}">
          <button class="ai-luxury-accordion-header-{{ ai_gen_id }}" data-accordion="details">
            <h3 class="ai-luxury-accordion-title-{{ ai_gen_id }}">Details</h3>
            <span class="ai-luxury-accordion-icon-{{ ai_gen_id }}">+</span>
          </button>
          <div class="ai-luxury-accordion-content-{{ ai_gen_id }}">
            <div class="ai-luxury-details-{{ ai_gen_id }}">
              {{ block.settings.product_details }}
              <p class="ai-luxury-disclaimer-{{ ai_gen_id }}">{{ block.settings.disclaimer_text }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</luxury-product-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupQuantityControls();
        this.setupColorTabs();
        this.setupSwatches();
        this.setupAccordion();
      }

      setupQuantityControls() {
        const decreaseBtn = this.querySelector('[data-action="decrease"]');
        const increaseBtn = this.querySelector('[data-action="increase"]');
        const input = this.querySelector('.ai-luxury-qty-input-{{ ai_gen_id }}');

        decreaseBtn.addEventListener('click', () => {
          const currentValue = parseInt(input.value);
          if (currentValue > 1) {
            input.value = currentValue - 1;
          }
        });

        increaseBtn.addEventListener('click', () => {
          const currentValue = parseInt(input.value);
          input.value = currentValue + 1;
        });
      }

      setupColorTabs() {
        const tabs = this.querySelectorAll('.ai-luxury-color-tab-{{ ai_gen_id }}');
        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
          });
        });
      }

      setupSwatches() {
        const swatches = this.querySelectorAll('.ai-luxury-swatch-{{ ai_gen_id }}');
        swatches.forEach(swatch => {
          swatch.addEventListener('click', () => {
            swatches.forEach(s => s.classList.remove('selected'));
            swatch.classList.add('selected');
          });
        });
      }

      setupAccordion() {
        const headers = this.querySelectorAll('.ai-luxury-accordion-header-{{ ai_gen_id }}');
        headers.forEach(header => {
          header.addEventListener('click', () => {
            const content = header.nextElementSibling;
            const icon = header.querySelector('.ai-luxury-accordion-icon-{{ ai_gen_id }}');
            
            content.classList.toggle('open');
            icon.classList.toggle('open');
          });
        });
      }
    }

    customElements.define('luxury-product-{{ ai_gen_id }}', LuxuryProduct{{ ai_gen_id }});
  })();
</script>

