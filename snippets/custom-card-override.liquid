  margin: 0;
  font-family: var(--font);
}

.iab-card-compare {
  font-size: 1rem;
  color: #AFC1CA;
  text-decoration: line-through;
  margin: 0;
  font-family: var(--font);
}

/* Shop Now button */
.iab-card-btn {
  display: block;
  width: 100%;
  padding: 20px 0;
  text-align: center;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #AFC1CA;
  background: transparent;
  border: 1px solid #AFC1CA;
  border-radius: 2px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
  box-sizing: border-box;
  font-family: var(--font);
  letter-spacing: -1.6%;
  line-height: 1.5rem;
}

.iab-card-btn:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.6);
  text-decoration: none;
}

@media (max-width:768px){
.iab-card-title {
  font-size: 16px;
  font-weight: 400;
}

.iab-card-price {
  font-size: 16px;
  font-weight: 500;
  color: #AFC1CA;
  margin: 0;
  font-family: var(--font);
}

.iab-card-compare {
  font-size: 12px;
  color: #AFC1CA;
  text-decoration: line-through;
  margin: 0;
  font-family: var(--font);
}

/* Shop Now button */
.iab-card-btn {
  display: block;
  width: 100%;
  padding: 14px 0;
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #AFC1CA;
  background: transparent;
  border: 1px solid #AFC1CA;
  border-radius: 2px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
  box-sizing: border-box;
  font-family: var(--font);
  line-height: 1;
}

.iab-card-btn:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.6);
  text-decoration: none;
}

}
</style>

<script>
(function () {
  'use strict';

  /* ══════════════════════════════════════════════════════
     WISHLIST — same localStorage key & event as your
     more-products section (shopify_wishlist)
  ══════════════════════════════════════════════════════ */
  var WISH_KEY = 'shopify_wishlist';

  function getWishlist() {
    try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch (e) { return []; }
  }

  function saveWishlist(list) {
    try { localStorage.setItem(WISH_KEY, JSON.stringify(list)); } catch (e) {}
    var ev = new CustomEvent('wishlist:updated', { detail: { wishlist: list } });
    document.dispatchEvent(ev);
    window.dispatchEvent(ev);
  }

  function isWishlisted(id) {
    return getWishlist().some(function (item) { return item.id === id; });
  }

  function toggleWishlist(btn) {
    var id    = parseInt(btn.dataset.productId, 10);
    var title = btn.dataset.productTitle || '';
    var image = btn.dataset.productImage || '';
    var price = parseFloat(btn.dataset.productPrice) || 0;
    var url   = btn.dataset.productUrl || '';

    var list = getWishlist();

    if (isWishlisted(id)) {
      list = list.filter(function (item) { return item.id !== id; });
      saveWishlist(list);
      btn.classList.remove('is-active');
      btn.setAttribute('aria-label', 'Add ' + title + ' to wishlist');
      if (window.CustomMenu && typeof window.CustomMenu.removeFromWishlist === 'function') {
        window.CustomMenu.removeFromWishlist(id);
      }
    } else {
      list.push({ id: id, title: title, image: image, price: Math.round(price), url: url });
      saveWishlist(list);
      btn.classList.add('is-active');
      btn.setAttribute('aria-label', 'Remove ' + title + ' from wishlist');
      if (window.CustomMenu && typeof window.CustomMenu.addToWishlist === 'function') {
        window.CustomMenu.addToWishlist({ id: id, title: title, image: image, price: Math.round(price), url: url });
      }
    }
  }

  function syncWishlistButtons() {
    document.querySelectorAll('.iab-wish-btn').forEach(function (btn) {
      var id = parseInt(btn.dataset.productId, 10);
      if (isWishlisted(id)) {
        btn.classList.add('is-active');
        btn.setAttribute('aria-label', 'Remove ' + (btn.dataset.productTitle || '') + ' from wishlist');
      } else {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-label', 'Add ' + (btn.dataset.productTitle || '') + ' to wishlist');
      }
    });
  }

  /* Click delegation — works for dynamically loaded cards too */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.iab-wish-btn');
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      toggleWishlist(btn);
    }

    var shopBtn = e.target.closest('.iab-card-btn[data-variant-id]');
    if (shopBtn) {
      e.preventDefault();
      e.stopPropagation();
      addToCart(shopBtn);
    }
  });

  function cartAddUrl() {
    var root = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
    return root + 'cart/add.js';
  }

  function cartUrl() {
    var root = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
    return root + 'cart.js';
  }

  function findCartIcon() {
    return document.querySelector(
      '[data-cart-icon], [data-cart-icon-bubble], .cart-icon, #cart-icon-bubble, .header-cart, #cart-icon, a[href="/cart"]'
    );
  }

  function showToast(message) {
    var toast = document.querySelector('.hz-atc-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'hz-atc-toast';
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    requestAnimationFrame(function () {
      toast.classList.add('is-visible');
    });
    clearTimeout(toast._hideTimer);
    toast._hideTimer = setTimeout(function () {
      toast.classList.remove('is-visible');
    }, 2200);
  }

  function flyToCart(sourceImgEl) {
    var cartTarget = findCartIcon();
    if (!sourceImgEl || !cartTarget) return;

    var startRect = sourceImgEl.getBoundingClientRect();
    var endRect = cartTarget.getBoundingClientRect();
    if (startRect.width === 0 || startRect.height === 0) return;

    var flyer = document.createElement('div');
    flyer.className = 'hz-atc-fly';
    flyer.style.left = startRect.left + 'px';
    flyer.style.top = startRect.top + 'px';
    flyer.style.width = startRect.width + 'px';
    flyer.style.height = startRect.height + 'px';
    flyer.style.opacity = '1';

    var flyerImg = document.createElement('img');
    flyerImg.src = sourceImgEl.currentSrc || sourceImgEl.src;
    flyer.appendChild(flyerImg);
    document.body.appendChild(flyer);

    requestAnimationFrame(function () {
      flyer.style.left = (startRect.left + (endRect.left - startRect.left) * 0.5) + 'px';
      flyer.style.top = (startRect.top - 60) + 'px';
      flyer.style.width = (startRect.width * 0.5) + 'px';
      flyer.style.height = (startRect.height * 0.5) + 'px';
    });

    setTimeout(function () {
      flyer.style.left = (endRect.left + endRect.width / 2 - 12) + 'px';
      flyer.style.top = (endRect.top + endRect.height / 2 - 12) + 'px';
      flyer.style.width = '24px';
      flyer.style.height = '24px';
      flyer.style.opacity = '0.25';
    }, 350);

    setTimeout(function () {
      flyer.remove();
      cartTarget.style.transition = 'transform 0.25s ease';
      cartTarget.style.transform = 'scale(1.18)';
      setTimeout(function () {
        cartTarget.style.transform = 'scale(1)';
      }, 200);
    }, 1250);
  }

  function updateCartCount(cart) {
    if (!cart) return;
    document.querySelectorAll('[data-cart-count], .cart-count-bubble, .cart-count').forEach(function (el) {
      el.textContent = cart.item_count;
    });
  }

  function openCartDrawer() {
    if (window.CustomMenu && typeof window.CustomMenu.openCart === 'function') {
      window.CustomMenu.openCart();
      return;
    }
    var drawer = document.querySelector('cart-drawer-component');
    if (drawer && typeof drawer.open === 'function') {
      drawer.open();
    }
  }

  function addToCart(btn) {
    if (btn.disabled || btn.dataset.iabSubmitting === 'true') return;

    var variantId = btn.getAttribute('data-variant-id');
    if (!variantId) return;

    var card = btn.closest('product-card');
    var sourceImgEl = card
      ? (card.querySelector('.product-media__image') || card.querySelector('img'))
      : null;
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.dataset.iabSubmitting = 'true';
    btn.textContent = 'Adding...';

    fetch(cartAddUrl(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
    })
      .then(function (res) {
        if (!res.ok) {
          return res.json().then(function (err) {
            throw new Error(err && err.description ? err.description : 'Could not add to cart');
          });
        }
        return res.json();
      })
      .then(function () {
        flyToCart(sourceImgEl);
        return fetch(cartUrl());
      })
      .then(function (res) { return res.json(); })
      .then(function (cart) {
        updateCartCount(cart);
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cart } }));
        document.dispatchEvent(new CustomEvent('cart:item-added', { detail: { cart: cart } }));
        openCartDrawer();
      })
      .catch(function (err) {
        showToast(err && err.message ? err.message : 'Could not add to cart');
      })
      .finally(function () {
        btn.disabled = false;
        btn.dataset.iabSubmitting = 'false';
        btn.textContent = originalText;
      });
  }

  /* Keep in sync when other sections update the wishlist */
  window.addEventListener('wishlist:updated', syncWishlistButtons);
  document.addEventListener('wishlist:updated', syncWishlistButtons);

  /* ══════════════════════════════════════════════════════
     CARD INJECTION
  ══════════════════════════════════════════════════════ */
  function injectCard(card) {
    var content = card.querySelector('.product-card__content');
    if (!content) return;

    var existingInfo = content.querySelector('.iab-card-info');
    if (existingInfo) {
      existingInfo.querySelectorAll('.iab-card-rating').forEach(function (el) {
        el.remove();
      });
    }

    /* After filter morph, cards may keep data-iabDone but lose custom UI */
    var needsCustomUi = !content.querySelector('.iab-card-info');
    if (!needsCustomUi) return;

    /* Strip stale custom UI leftovers before rebuild */
    content.querySelectorAll('.iab-card-info, .iab-wish-btn').forEach(function (el) {
      el.remove();
    });
    delete card.dataset.iabDone;
    card.dataset.iabDone = '1';

    /* Product URL */
    var productUrl = '#';
    var linkEl = card.querySelector('a.product-card__link');
    if (linkEl) productUrl = linkEl.getAttribute('href') || '#';

    /* Product ID & handle for wishlist */
    var productId = card.dataset.productId || '';

    /* Title — from visually-hidden span */
    var title = '';
    var hiddenSpan = linkEl ? linkEl.querySelector('.visually-hidden') : null;
    if (hiddenSpan) title = hiddenSpan.textContent.trim();
    if (!title) {
      var titleP = content.querySelector('a[ref="productTitleLink"] p');
      if (titleP) title = titleP.textContent.trim();
    }

    /* Limit title to first 2 words */
    if (title) {
      var titleWords = title.split(/\s+/);
      if (titleWords.length > 2) {
        title = titleWords.slice(0, 2).join(' ');
      }
    }

    /* Price — read before CSS hides product-price */
    var price = '';
    var comparePrice = '';
    var salePriceBlock    = content.querySelector('.price__sale');
    var regularPriceBlock = content.querySelector('.price__regular');

    if (salePriceBlock && !salePriceBlock.classList.contains('price__hidden')) {
      var salePriceEl    = salePriceBlock.querySelector('.price-item--sale');
      var comparePriceEl = salePriceBlock.querySelector('.price-item--regular.compare-at-price');
      if (salePriceEl)    price        = salePriceEl.textContent.trim();
      if (comparePriceEl) comparePrice = comparePriceEl.textContent.trim();
    } else if (regularPriceBlock) {
      var regularEl = regularPriceBlock.querySelector('.price');
      if (regularEl) price = regularEl.textContent.trim();
    }

    var productImage = '';
    var imgEl = content.querySelector('.product-media__image');
    if (imgEl) productImage = imgEl.getAttribute('src') || '';

    /* Raw price number for wishlist storage */
    var rawPrice = price.replace(/[^0-9.]/g, '') || '0';

    /* ── Heart button into gallery ─────────────────── */
    var gallery = content.querySelector('.card-gallery');
    if (gallery && !gallery.querySelector('.iab-wish-btn')) {
      var heartBtn = document.createElement('button');
      heartBtn.className            = 'iab-wish-btn';
      heartBtn.type                 = 'button';
      heartBtn.dataset.productId    = productId;
      heartBtn.dataset.productTitle = title;
      heartBtn.dataset.productImage = productImage;
      heartBtn.dataset.productPrice = rawPrice;
      heartBtn.dataset.productUrl   = productUrl;
      heartBtn.setAttribute('aria-label', 'Add ' + title + ' to wishlist');

      heartBtn.innerHTML =
        '<svg class="iab-wish-empty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">'
        + '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>'
        + '</svg>'
        + '<svg class="iab-wish-filled" viewBox="0 0 24 24" fill="#ff4d6d" stroke="#ff4d6d" stroke-width="1.6">'
        + '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>'
        + '</svg>';

      gallery.appendChild(heartBtn);
    }

    /* ── Info block ────────────────────────────────── */
    var info = document.createElement('div');
    info.className = 'iab-card-info';

    var comparePriceHtml = comparePrice
      ? '<span class="iab-card-compare">' + comparePrice + '</span>'
      : '';

    var variantId = '';
    var variantInput = content.querySelector('form[data-type="add-to-cart-form"] input[name="id"]');
    if (variantInput) variantId = variantInput.value;

    var addToCartDisabled = false;
    var hiddenSubmit = content.querySelector('form[data-type="add-to-cart-form"] button[type="submit"][name="add"]');
    if (hiddenSubmit && hiddenSubmit.disabled) addToCartDisabled = true;

    var safeTitle = (title || 'Product').replace(/"/g, '&quot;');
    var shopNowHtml = variantId && !addToCartDisabled
      ? '<button type="button" class="iab-card-btn" data-variant-id="' + variantId + '" data-product-title="' + safeTitle + '">Shop Now</button>'
      : '<span class="iab-card-btn" style="opacity:0.5;cursor:not-allowed;">Sold Out</span>';

    info.innerHTML =
      '<div class="iab-card-row-1">'
        + '<a href="' + productUrl + '" class="iab-card-title">' + (title || 'Product') + '</a>'
      + '</div>'
      + '<div class="iab-card-row-2">'
        + '<span class="iab-card-price">' + (price || '') + '</span>'
        + comparePriceHtml
      + '</div>'
      + shopNowHtml;

    content.appendChild(info);
  }

  /* Load sharper images — theme "small" card size requests ~165px src for ~400px display */
  function sharpenGalleryImages(gallery) {
    if (!gallery) return;

    gallery.querySelectorAll('.product-media__image, img').forEach(function (img) {
      img.sizes = '(min-width: 750px) 420px, 100vw';
    });
  }

  var facetsOriginalParent = null;
  var facetsOriginalNextSibling = null;
  var facetsMountOriginalParent = null;
  var facetsMountOriginalNextSibling = null;

  function disableFacetOverflow(root) {
    if (!root) return;
    root.querySelectorAll('overflow-list').forEach(function (list) {
      try {
        if (typeof list.showAll === 'function') {
          list.showAll();
        } else {
          list.setAttribute('disabled', 'true');
        }
      } catch (e) {
        list.setAttribute('disabled', 'true');
      }
    });
  }

  function findCollectionFacets(wrapper, banner) {
    if (banner) {
      var inSlot = banner.querySelector('.pbanner-filters-slot .facets-block-wrapper--horizontal');
      if (inSlot) return inSlot;
    }

    if (wrapper) {
      var inWrapper = wrapper.querySelector('.facets-block-wrapper--horizontal');
      if (inWrapper) return inWrapper;
    }

    return document.querySelector('.collection-wrapper .facets-block-wrapper--horizontal');
  }

  function getFacetsMountNode(facets, wrapper) {
    if (!facets) return null;
    if (!wrapper) return facets;

    var shopifyBlock = facets.closest('.shopify-block');
    if (shopifyBlock && wrapper.contains(shopifyBlock)) return shopifyBlock;

    return facets;
  }

  function rememberFacetsHome(mountNode, wrapper) {
    if (!mountNode || !wrapper || !wrapper.contains(mountNode)) return;
    if (facetsMountOriginalParent) return;

    facetsMountOriginalParent = mountNode.parentElement;
    facetsMountOriginalNextSibling = mountNode.nextElementSibling;

    if (mountNode.querySelector('.facets-block-wrapper--horizontal')) {
      facetsOriginalParent = wrapper;
      facetsOriginalNextSibling = mountNode.nextElementSibling;
    }
  }

  function restoreFacetsMount(mountNode) {
    if (!mountNode || !facetsMountOriginalParent) return false;
    if (mountNode.parentElement === facetsMountOriginalParent) return true;

    if (facetsMountOriginalNextSibling && facetsMountOriginalNextSibling.parentElement === facetsMountOriginalParent) {
      facetsMountOriginalParent.insertBefore(mountNode, facetsMountOriginalNextSibling);
    } else {
      facetsMountOriginalParent.appendChild(mountNode);
    }

    return true;
  }

  function clearMobileFacetPanelPosition(panel) {
    if (!panel) return;
    panel.style.removeProperty('position');
    panel.style.removeProperty('top');
    panel.style.removeProperty('left');
    panel.style.removeProperty('right');
    panel.style.removeProperty('transform');
    panel.style.removeProperty('width');
    panel.style.removeProperty('min-width');
    panel.style.removeProperty('max-width');
    panel.style.removeProperty('z-index');
  }

  function positionMobileFacetDropdown(details) {
    if (!details) return;

    var panel = details.querySelector('floating-panel-component');
    if (!panel) return;

    if (!details.open) {
      clearMobileFacetPanelPosition(panel);
      return;
    }

    var summary = details.querySelector('.facets__summary') || details;
    var gutter = 16;
    var summaryRect = summary.getBoundingClientRect();

    panel.dataset.iabPositioning = '1';
    panel.style.setProperty('position', 'absolute', 'important');
    panel.style.setProperty('top', 'calc(100% + 8px)', 'important');
    panel.style.setProperty('right', 'auto', 'important');
    panel.style.setProperty('transform', 'none', 'important');
    panel.style.setProperty('margin', '0', 'important');
    panel.style.setProperty('left', '0px', 'important');

    var maxWidth = Math.max(160, window.innerWidth - gutter * 2);
    panel.style.setProperty('max-width', maxWidth + 'px', 'important');

    var panelWidth = Math.min(panel.offsetWidth || 280, maxWidth);
    var left = 0;
    var overflowRight = summaryRect.left + panelWidth + gutter - window.innerWidth;
    if (overflowRight > 0) left = -overflowRight;
    if (summaryRect.left + left < gutter) left = gutter - summaryRect.left;

    panel.style.setProperty('left', left + 'px', 'important');

    requestAnimationFrame(function () {
      panel.dataset.iabPositioning = '0';
    });
  }

  function resetMobileFacetPanelStyles(root) {
    if (!root) return;
    root.querySelectorAll('.facets__panel').forEach(function (details) {
      if (details.open) {
        positionMobileFacetDropdown(details);
      } else {
        clearMobileFacetPanelPosition(details.querySelector('floating-panel-component'));
      }
    });
  }

  function patchMobileFacetPanels(root) {
    if (!root) return;
    root.querySelectorAll('floating-panel-component').forEach(function (panel) {
      if (panel.dataset.iabMobilePatch === '1') return;
      panel.dataset.iabMobilePatch = '1';

      new MutationObserver(function () {
        if (panel.dataset.iabPositioning === '1') return;
        var details = panel.closest('.facets__panel');
        if (!details || !details.open) return;
        positionMobileFacetDropdown(details);
      }).observe(panel, { attributes: true, attributeFilter: ['style'] });
    });
  }

  function bindMobileFacetPanels(root) {
    if (!root || root.dataset.iabFacetPanelsBound === '1') return;
    root.dataset.iabFacetPanelsBound = '1';

    root.addEventListener('toggle', function (e) {
      var panel = e.target;
      if (!panel || panel.tagName !== 'DETAILS' || !panel.classList.contains('facets__panel')) return;

      if (panel.open) {
        root.querySelectorAll('.facets__panel').forEach(function (other) {
          if (other !== panel) {
            other.removeAttribute('open');
            clearMobileFacetPanelPosition(other.querySelector('floating-panel-component'));
          }
        });
      }

      requestAnimationFrame(function () {
        positionMobileFacetDropdown(panel);
      });
      setTimeout(function () {
        positionMobileFacetDropdown(panel);
      }, 60);
    }, true);

    root.addEventListener('click', function (e) {
      var summary = e.target.closest('.facets__summary');
      if (!summary || !root.contains(summary)) return;
      var details = summary.closest('.facets__panel');
      if (!details) return;
      setTimeout(function () {
        positionMobileFacetDropdown(details);
      }, 0);
      setTimeout(function () {
        positionMobileFacetDropdown(details);
      }, 80);
    }, true);

    patchMobileFacetPanels(root);
    resetMobileFacetPanelStyles(root);
  }

  function bindFacetOutsideClose() {
    if (document.documentElement.dataset.iabFacetCloseBound === '1') return;
    document.documentElement.dataset.iabFacetCloseBound = '1';

    document.addEventListener('click', function (e) {
      document.querySelectorAll('.facets--horizontal .facets__panel[open]').forEach(function (details) {
        if (details.contains(e.target)) return;
        details.removeAttribute('open');
        clearMobileFacetPanelPosition(details.querySelector('floating-panel-component'));
      });
    });
  }

  function relocateCollectionFilters() {
    var banner = document.querySelector('.pbanner-container--collection');
    var wrapper = document.querySelector('.collection-wrapper');
    var facets = findCollectionFacets(wrapper, banner);

    if (!facets) return;

    var mountNode = getFacetsMountNode(facets, wrapper) || facets;
    rememberFacetsHome(mountNode, wrapper);

    var isDesktop = window.matchMedia('(min-width: 990px)').matches;

    if (isDesktop && banner) {
      var slot = banner.querySelector('.pbanner-filters-slot') || document.getElementById('CollectionFiltersSlot');
      if (!slot) {
        slot = document.createElement('div');
        slot.className = 'pbanner-filters-slot';
        slot.id = 'CollectionFiltersSlot';
        banner.appendChild(slot);
      }

      if (mountNode.parentElement !== slot) {
        slot.appendChild(mountNode);
      }

      slot.removeAttribute('aria-hidden');
      slot.classList.add('is-populated');
      document.body.classList.add('iab-filters-in-banner');

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          disableFacetOverflow(facets);
          bindMobileFacetPanels(facets);
          patchMobileFacetPanels(facets);
          resetMobileFacetPanelStyles(facets);
          bindFacetOutsideClose();
        });
      });
      return;
    }

    document.body.classList.remove('iab-filters-in-banner');

    restoreFacetsMount(mountNode);

    var mobileSlot = banner ? banner.querySelector('.pbanner-filters-slot') : null;
    if (mobileSlot) {
      mobileSlot.classList.remove('is-populated');
      mobileSlot.setAttribute('aria-hidden', 'true');
    }

    disableFacetOverflow(facets);
    bindMobileFacetPanels(facets);
    patchMobileFacetPanels(facets);
    resetMobileFacetPanelStyles(facets);
    bindFacetOutsideClose();
  }

  function processAll() {
    relocateCollectionFilters();

    document.querySelectorAll('.product-grid product-card, results-list product-card').forEach(function (card) {
      injectCard(card);
      var gallery = card.querySelector('.card-gallery');
      if (gallery) sharpenGalleryImages(gallery);
    });
    syncWishlistButtons();
  }

  function staggerFadeInCards() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var items = document.querySelectorAll('.product-grid > .product-grid__item');
    items.forEach(function (item, index) {
      item.style.setProperty('--iab-stagger', String(index));
      item.style.animation = 'none';
      void item.offsetWidth;
      item.style.animation = '';
    });
  }

  var processAllTimers = [];
  var staggerTimer = null;
  function scheduleProcessAll(extraDelays, replayStagger) {
    /* filter:update fires BEFORE section morph finishes — retry several times */
    var delays = extraDelays || [0, 50, 150, 350, 700, 1200, 2000];
    processAllTimers.forEach(clearTimeout);
    processAllTimers = delays.map(function (ms) {
      return setTimeout(processAll, ms);
    });
    if (replayStagger) {
      clearTimeout(staggerTimer);
      staggerTimer = setTimeout(staggerFadeInCards, 400);
    }
  }

  function watchForGridUpdates() {
    document.addEventListener('filter:update', function () {
      scheduleProcessAll(null, true);
    });

    /* Also catch Clear all / back-forward URL changes */
    window.addEventListener('popstate', function () {
      scheduleProcessAll(null, true);
    });

    /*
      Observe a STABLE ancestor — .product-grid itself is replaced on filter
      morph, which disconnects any observer attached only to that node.
    */
    var observeRoot =
      document.querySelector('results-list') ||
      document.querySelector('.product-grid-container') ||
      document.querySelector('.shopify-section') ||
      document.body;

    if (observeRoot) {
      new MutationObserver(function (mutations) {
        var shouldRefresh = false;
        for (var i = 0; i < mutations.length; i++) {
          var m = mutations[i];
          if (m.type !== 'childList') continue;
          if (m.addedNodes.length || m.removedNodes.length) {
            shouldRefresh = true;
            break;
          }
        }
        if (shouldRefresh) scheduleProcessAll([0, 80, 250, 500], false);
      }).observe(observeRoot, { childList: true, subtree: true });

      var bannerRoot = document.querySelector('.pbanner-container--collection');
      if (bannerRoot) {
        new MutationObserver(function () {
          scheduleProcessAll([0, 100, 300], false);
        }).observe(bannerRoot, { childList: true, subtree: true });
      }
    }
  }

  window.addEventListener('resize', function () {
    relocateCollectionFilters();
    var root = document.querySelector('.collection-wrapper .facets-block-wrapper--horizontal');
    if (root) resetMobileFacetPanelStyles(root);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      processAll();
      watchForGridUpdates();
    });
  } else {
    processAll();
    watchForGridUpdates();
  }

  document.addEventListener('shopify:section:load', function () {
    scheduleProcessAll([0, 100, 300, 600], false);
  });

  document.addEventListener('shopify:section:reorder', function () {
    scheduleProcessAll([0, 100, 300, 600], false);
  });

})();
</script>