  top: 16px;
  right: 20px;
  z-index: 10;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: transparent;
  {% comment %} backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px); {% endcomment %}
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  padding: 0;
  transition: background 0.2s, transform 0.15s;
}

