    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "background", "label": "Full background" },
        { "value": "top", "label": "Top of popup" }
      ],
      "default": "background"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading — line 1",
      "default": "Get"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading — line 2",
      "default": "10% off"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Sign up with IM BITCH and be the first to know about our special offers, new drops, and all things on time.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email field placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text"
    },
    {
      "type": "header",
      "content": "Fonts"
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading font family",
      "info": "Must already be loaded in your theme (e.g. via a custom @font-face). Use the exact CSS font-family name.",
      "default": "Degular Display, sans-serif"
    },
    {
      "type": "text",
      "id": "subheading_font_family",
      "label": "Subheading font family",
      "default": "Degular Display, sans-serif"
    },
    {
      "type": "text",
      "id": "body_font_family",
      "label": "Email field, button & fine print font family",
