{{ 'component-email-popup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign popup_id = 'email-popup-' | append: section.id
  assign delay_seconds = section.settings.delay_seconds | times: 1000
  assign frequency_days = section.settings.frequency_days
-%}

{%- if section.settings.enabled -%}

<style>
  #{{ popup_id }} {
    /* Overlay & popup surface colors */
    --overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --popup-background: {{ section.settings.background_color }};
    --popup-text-color: {{ section.settings.text_color }};
    --popup-heading-color: {{ section.settings.heading_color }};
    --popup-button-background: {{ section.settings.button_background }};
    --popup-button-text-color: {{ section.settings.button_text_color }};

    /* Fonts */
    --heading-font-family: {{ section.settings.heading_font_family }};
    --subheading-font-family: {{ section.settings.subheading_font_family }};
    --body-font-family: {{ section.settings.body_font_family }};
    --input-button-font-size: {{ section.settings.input_button_font_size }}px;

    /* Desktop & tablet sizing (matches design spec) */
    --popup-width: {{ section.settings.popup_width_desktop }}px;
    --popup-height: {{ section.settings.popup_height_desktop }}px;
    --heading-font-size: {{ section.settings.heading_font_size_desktop }}px;
    --heading-line-height: 0.9;
    --heading-letter-spacing: 0.01em;
    --subheading-font-size: {{ section.settings.subheading_font_size_desktop }}px;
    --subheading-line-height: 1.3;
    --subheading-letter-spacing: 0.01em;
    --form-width: {{ section.settings.form_width_desktop }}px;
    --form-height: {{ section.settings.form_height_desktop }}px;
    --form-gap: {{ section.settings.form_gap_desktop }}px;
    --close-size: {{ section.settings.close_size_desktop }}px;
    --close-offset: {{ section.settings.close_offset_desktop }}px;
    --close-border-width: {{ section.settings.close_border_width_desktop }}px;
    --close-padding: {{ section.settings.close_padding_desktop }}px;
    --close-icon-size: {{ section.settings.close_icon_size_desktop }}px;
    --input-letter-spacing: -0.016em;
    --button-line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    #{{ popup_id }} {
      --popup-width: {{ section.settings.popup_width_mobile }}px;
      --popup-height: {{ section.settings.popup_height_mobile }}px;
      --heading-font-size: {{ section.settings.heading_font_size_mobile }}px;
      --subheading-font-size: {{ section.settings.subheading_font_size_mobile }}px;
      --form-width: {{ section.settings.form_width_mobile }}px;
      --form-height: {{ section.settings.form_height_mobile }}px;
      --form-gap: {{ section.settings.form_gap_mobile }}px;
      --close-size: {{ section.settings.close_size_mobile }}px;
      --close-offset: {{ section.settings.close_offset_mobile }}px;
      --close-border-width: {{ section.settings.close_border_width_mobile }}px;
      --close-padding: {{ section.settings.close_padding_mobile }}px;
      --close-icon-size: {{ section.settings.close_icon_size_mobile }}px;
    }
  }
</style>

<div
  id="{{ popup_id }}"
  class="email-popup"
  data-email-popup
  data-delay="{{ delay_seconds }}"
  data-frequency="{{ frequency_days }}"
  data-cookie-name="email_popup_closed_{{ section.id }}"
  aria-hidden="true"
>
  <div class="email-popup__overlay" data-email-popup-overlay></div>

  <div
    class="email-popup__container"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ popup_id }}-heading"
  >
    {%- if section.settings.image != blank -%}
      <div class="email-popup__image-wrapper email-popup__image-wrapper--{{ section.settings.image_position }}">
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 500px, 100vw',
            widths: '375, 550, 750, 1000, 1500',
            class: 'email-popup__image'
        }}
      </div>
    {%- endif -%}

    <button
      type="button"
      class="email-popup__close"
      data-email-popup-close
      aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
    >
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <div class="email-popup__content">
      <div class="email-popup__content_wrapper">
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
          <h2 id="{{ popup_id }}-heading" class="email-popup__heading-group" style="margin: 0;">
            {%- if section.settings.heading_line_1 != blank -%}
              <div class="email-popup__heading">{{ section.settings.heading_line_1 }}</div>
            {%- endif -%}
            {%- if section.settings.heading_line_2 != blank -%}
              <div class="email-popup__heading">{{ section.settings.heading_line_2 }}</div>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="email-popup__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- form 'customer', id: popup_id, class: 'email-popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="email-popup__success">
              {{ section.settings.success_message | default: "Thanks for subscribing!" }}
            </p>
          {%- else -%}
            <div class="email-popup__field-group">
              <label for="{{ popup_id }}-email" class="visually-hidden">
                {{ section.settings.email_placeholder }}
              </label>
              <input
                id="{{ popup_id }}-email"
                type="email"
                name="contact[email]"
                class="email-popup__input"
                placeholder="{{ section.settings.email_placeholder }}"
                autocomplete="email"
                required
              >
              {%- if form.errors -%}
                <p class="email-popup__error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            </div>

            <button type="submit" class="email-popup__submit">
              {{ section.settings.button_label | default: "Subscribe" }}
            </button>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="email-popup__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'email-popup.js' | asset_url }}" defer="defer"></script>

{%- endif -%}

{% schema %}
{
  "name": "Email popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
