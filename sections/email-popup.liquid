      "default": "Gilroy, sans-serif"
    },
    {
      "type": "range",
      "id": "input_button_font_size",
      "label": "Email field & button font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Desktop & tablet sizing"
    },
    {
      "type": "range",
      "id": "popup_width_desktop",
      "label": "Popup width",
      "min": 453,
      "max": 553,
      "step": 1,
      "unit": "px",
      "default": 503
    },
    {
      "type": "range",
      "id": "popup_height_desktop",
      "label": "Popup height",
      "min": 510,
      "max": 610,
      "step": 1,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
