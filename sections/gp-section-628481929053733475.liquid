      <script id="custom-js-girLIUfpsZ">
        try {
          //const currentElement = document.getElementsByClassName('girLIUfpsZ');

document.addEventListener('DOMContentLoaded', () => {
  const banners = document.querySelectorAll('.girLIUfpsZ .gp-tab-header-list .gp-tab-item');
  const tabs = document.querySelectorAll('.girLIUfpsZ .gp-tab-content');

  banners.forEach((banner, index) => {
    banner.addEventListener('click', () => {

      banners.forEach(b => b.classList.remove('gps_active'));
      tabs.forEach(t => t.classList.remove('gps_active'));

      banner.classList.add('gps_active');
      if (tabs[index]) {
        tabs[index].classList.add('gps_active');
        
      }
    });
  });
});
