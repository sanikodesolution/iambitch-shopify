{% comment %}
  Brand Marquee Section — Infinite Scroll Logo Strip
  All spacing, colors, gaps, and logos are editable from the Theme Customizer.

  FIX NOTE:
  When there are only a few logo blocks, one duplicated copy of the logos
  is not wide enough to fill the screen. Since the animation only shifts
  the track by -50% (i.e. one full copy), a visible empty gap appears
  after the last logo before the loop restarts.

  Fix: render 4 copies of the logo set instead of 2, and shift the track
  by -25% instead of -50%. This guarantees the strip is always wide
  enough to cover the viewport (even with very few logos) and the loop
  is perfectly seamless with no trailing gap.
{% endcomment %}

<style>
  #brand-marquee-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    width: 100%;
    height: {{ section.settings.section_height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    position: relative;
  }

  #brand-marquee-{{ section.id }} .marquee-track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    width: max-content;
    animation: marquee-scroll-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
    gap: {{ section.settings.logo_gap }}px;
  }

  {% if section.settings.pause_on_hover %}
  #brand-marquee-{{ section.id }}:hover .marquee-track {
    animation-play-state: paused;
  }
  {% endif %}

  #brand-marquee-{{ section.id }} .marquee-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #brand-marquee-{{ section.id }} .marquee-item img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    max-width: {{ section.settings.logo_max_width }}px;
    object-fit: contain;
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
    display: block;
  }

  {% if section.settings.hover_full_opacity %}
  #brand-marquee-{{ section.id }} .marquee-item img:hover {
    opacity: 1;
  }
  {% endif %}

  {% if section.settings.show_fade_edges %}
  #brand-marquee-{{ section.id }}::before,
  #brand-marquee-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: {{ section.settings.fade_width }}px;
    z-index: 2;
    pointer-events: none;
  }

  #brand-marquee-{{ section.id }}::before {
    left: 0;
    background: linear-gradient(to right, {{ section.settings.bg_color }}, transparent);
  }

  #brand-marquee-{{ section.id }}::after {
    right: 0;
    background: linear-gradient(to left, {{ section.settings.bg_color }}, transparent);
  }
  {% endif %}

  /* Shift by -25% because we now render 4 identical copies of the logo
     set. Shifting exactly one copy's worth (1/4 of total width) keeps
     the loop perfectly seamless no matter how few logos are added. */
  @keyframes marquee-scroll-{{ section.id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #brand-marquee-{{ section.id }} .marquee-track {
      animation: none;
    }
  }
</style>

<div id="brand-marquee-{{ section.id }}" class="brand-marquee-section" role="region" aria-label="{{ section.settings.aria_label }}">
  <div class="marquee-track">
    {% comment %} Render 4 copies of the logo set back to back so the strip is always wide enough to loop seamlessly, even with only a few logos. Only the first copy is announced to screen readers; the rest are aria-hidden duplicates. {% endcomment %}
    {% for copy in (1..4) %}
      {% for block in section.blocks %}
        {% if block.type == 'logo' %}
          <div class="marquee-item" {% if copy == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            {% if block.settings.logo_link != blank %}
              <a href="{{ block.settings.logo_link }}" target="_blank" rel="noopener noreferrer" {% if copy == 1 %}aria-label="{{ block.settings.logo_alt }}"{% else %}tabindex="-1"{% endif %}>
            {% endif %}

            {% if block.settings.logo_image != blank %}
              <img
                src="{{ block.settings.logo_image | image_url: width: 400 }}"
                alt="{% if copy == 1 %}{{ block.settings.logo_alt | default: 'Brand logo' }}{% endif %}"
                loading="lazy"
                width="{{ block.settings.logo_image.width }}"
                height="{{ block.settings.logo_image.height }}"
              >
            {% else %}
              <span style="color: {{ section.settings.placeholder_color }}; font-size: {{ section.settings.logo_height | times: 0.4 | round }}px; font-weight: 600; white-space: nowrap;">
                {{ block.settings.logo_alt | default: 'Brand Name' }}
              </span>
            {% endif %}

            {% if block.settings.logo_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Brand Marquee",
  "tag": "section",
  "class": "section-brand-marquee",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (px)",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 100
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 16,
      "max": 100,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo Max Width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 160
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap Between Logos (px)",
      "min": 20,
      "max": 200,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo Opacity (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "hover_full_opacity",
      "label": "Full Opacity on Hover",
      "default": true
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder Text Color (no image)",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Scroll Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed (seconds, lower = faster)",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Scroll on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Fade Edges"
    },
    {
      "type": "checkbox",
      "id": "show_fade_edges",
      "label": "Show Fade on Left & Right Edges",
      "default": true
    },
    {
      "type": "range",
      "id": "fade_width",
      "label": "Fade Edge Width (px)",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section ARIA Label",
      "default": "As seen in"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Brand Name / Alt Text",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Marquee",
      "blocks": [
        { "type": "logo", "settings": { "logo_alt": "Cosmopolitan" } },
        { "type": "logo", "settings": { "logo_alt": "Vogue" } },
        { "type": "logo", "settings": { "logo_alt": "Allure" } },
        { "type": "logo", "settings": { "logo_alt": "Beauty Insider" } },
        { "type": "logo", "settings": { "logo_alt": "ELLE" } },
        { "type": "logo", "settings": { "logo_alt": "Marie Claire" } },
        { "type": "logo", "settings": { "logo_alt": "Teen Vogue" } }
      ]
    }
  ]
}
{% endschema %}
