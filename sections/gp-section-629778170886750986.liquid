    <div
      data-id="gZHMLLKG_l"
      style="--bs:none;--bw:1px 1px 1px 1px;--bc:var(--g-c-line-3, line-3);--d:block;--d-mobile:block;--d-tablet:block;--op:100%;--bblr:0px;--bbrr:0px;--btlr:0px;--btrr:0px;--ta:left;--bgc:transparent;--bgi:url();--bgp:50% 50%;--bgs:cover;--bgr:no-repeat;--bga:scroll"
      data-keep-class="true"
      class="gZHMLLKG_l gp-custom-code">
      <div>
    <script>
  /* ============================================================
     Wishlist — synced with both storage keys used across the site
     (shopify_wishlist from product page + cnav_wishlist from header)
     Now uses event delegation, no inline onclick.
  ============================================================ */
  window.MprodWishlist = window.MprodWishlist || (function () {

    var WISH_KEY = 'cnav_wishlist';

    function getList() {
      try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch(e) { return []; }
    }

    function saveList(list) {
      try { localStorage.setItem(WISH_KEY, JSON.stringify(list)); } catch(e) {}
      var ev = new CustomEvent('wishlist:updated', { detail: { wishlist: list } });
      document.dispatchEvent(ev);
      window.dispatchEvent(ev);
    }

    function isInList(id) {
      return getList().some(function(item) { return item.id === id; });
    }

    function toggle(btnEl) {
      var id = parseInt(btnEl.getAttribute('data-product-id'), 10);
      var title = btnEl.getAttribute('data-product-title');
      var image = btnEl.getAttribute('data-product-image');
      var price = parseFloat(btnEl.getAttribute('data-product-price')) || 0;

      var currentlyWishlisted = isInList(id);
      var list = getList();

      if (currentlyWishlisted) {
        list = list.filter(function(item) { return item.id !== id; });
        saveList(list);
        btnEl.classList.remove('is-active');
        btnEl.setAttribute('aria-label', 'Add ' + title + ' to wishlist');

        if (window.CustomMenu && typeof window.CustomMenu.removeFromWishlist === 'function') {
          window.CustomMenu.removeFromWishlist(id);
        }
      } else {
        var product = {
          id:    id,
          title: title,
          image: image,
          price: Math.round(price),
          url:   window.location.origin + '/products/' + id  // note: this uses ID, not handle
        };
        list.push(product);
        saveList(list);
        btnEl.classList.add('is-active');
        btnEl.setAttribute('aria-label', 'Remove ' + title + ' from wishlist');

        if (window.CustomMenu && typeof window.CustomMenu.addToWishlist === 'function') {
          window.CustomMenu.addToWishlist(product);
        }
      }
    }

    function syncAll() {
      document.querySelectorAll('.mprod-wish-btn').forEach(function(btn) {
        var id = parseInt(btn.getAttribute('data-product-id'), 10);
        if (isInList(id)) {
          btn.classList.add('is-active');
          var title = btn.getAttribute('data-product-title') || '';
          btn.setAttribute('aria-label', 'Remove ' + title + ' from wishlist');
        } else {
          btn.classList.remove('is-active');
        }
      });
    }

    // Attach click events using delegation (works for dynamically added buttons)
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.mprod-wish-btn');
      if (btn) {
        e.preventDefault();
        toggle(btn);
      }
    });

    return {
      syncAll: syncAll,
      // keep toggle accessible for any legacy calls (optional)
      toggle: toggle
    };

  })();

  document.addEventListener('DOMContentLoaded', function() {
    window.MprodWishlist.syncAll();
  });

  window.addEventListener('wishlist:updated', function() {
    window.MprodWishlist.syncAll();
  });
</script>
