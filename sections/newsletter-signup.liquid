{% style %}
  .newsletter-signup-{{ section.id }} {
    --ns-bg: {{ section.settings.background_color }};
    --ns-text: {{ section.settings.text_color }};
    --ns-btn-bg: {{ section.settings.button_background }};
    --ns-btn-text: {{ section.settings.button_text_color }};
    --ns-logo-pt: {{ section.settings.logo_padding_top }}px;
    --ns-logo-mb: {{ section.settings.logo_margin_bottom }}px;
    --ns-heading-mb: {{ section.settings.heading_margin_bottom }}px;
    --ns-subheading-mb: {{ section.settings.subheading_margin_bottom }}px;
    --ns-field-gap: {{ section.settings.field_gap }}px;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__wrapper {
    display: flex;
    min-height: 480px;
    width: 100%;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__image {
    flex: 1 1 50%;
    display: none;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__content {
    flex: 1 1 50%;
    background: var(--ns-bg);
    color: var(--ns-text);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 24px 32px 48px;
    width: 100%;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__inner {
    max-width: 380px;
    width: 100%;
    text-align: center;
    margin: 0 auto;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__logo {
    max-width: 160px;
    margin: 0 auto;
    display: block;
    padding-top: var(--ns-logo-pt);
    margin-bottom: var(--ns-logo-mb);
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__logo-text {
    font-size: 22px;
    letter-spacing: 0.15em;
    font-weight: 600;
    border: 1px solid var(--ns-text);
    border-radius: 50%;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    margin-right: auto;
    margin-top: var(--ns-logo-pt);
    margin-bottom: var(--ns-logo-mb);
    line-height: 1.3;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__heading {
    font-size: 32px;
    font-weight: 500;
    margin: 0 0 var(--ns-heading-mb);
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__subheading {
    font-size: 15px;
    opacity: 0.75;
    margin: 0 0 var(--ns-subheading-mb);
    line-height: 1.5;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__field-row {
    display: flex;
    flex-direction: column;
    gap: var(--ns-field-gap);
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__input {
    width: 100%;
    padding: 14px 16px;
    border: none;
    border-radius: 2px;
    font-size: 14px;
    box-sizing: border-box;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__button {
    width: 100%;
    padding: 14px 16px;
    background: var(--ns-btn-bg);
    color: var(--ns-btn-text);
    border: none;
    border-radius: 2px;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__button:hover {
    opacity: 0.9;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__success {
    font-size: 15px;
  }

  .newsletter-signup-{{ section.id }} .newsletter-signup__error {
    color: #ff8a8a;
    font-size: 13px;
    margin-top: 10px;
  }

  @media screen and (min-width: 750px) {
    .newsletter-signup-{{ section.id }} .newsletter-signup__image {
      display: block;
    }
  }
  div#cnavBar {
    display: none;
}
body.page-width-narrow.card-hover-effect-none.cnav-loaded {
    padding-top: unset !important;
}

footer {
    display: none;
}
{% endstyle %}

<div class="newsletter-signup-{{ section.id }}">
  <div class="newsletter-signup__wrapper">

    {%- if section.settings.side_image != blank -%}
      <div class="newsletter-signup__image">
        <img
          src="{{ section.settings.side_image | image_url: width: 1500 }}"
          srcset="{{ section.settings.side_image | image_url: width: 750 }} 750w,
                  {{ section.settings.side_image | image_url: width: 1500 }} 1500w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ section.settings.side_image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.side_image.width }}"
          height="{{ section.settings.side_image.height }}"
        >
      </div>
    {%- endif -%}

    <div class="newsletter-signup__content">
      <div class="newsletter-signup__inner">

        {%- if section.settings.logo_image != blank -%}
          <img
            class="newsletter-signup__logo"
            src="{{ section.settings.logo_image | image_url: width: 400 }}"
            alt="{{ section.settings.logo_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.logo_image.width }}"
            height="{{ section.settings.logo_image.height }}"
          >
        {%- else -%}
          <div class="newsletter-signup__logo-text">{{ section.settings.logo_text }}</div>
        {%- endif -%}

        <h2 class="newsletter-signup__heading">{{ section.settings.heading }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="newsletter-signup__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter-signup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-signup__success">{{ section.settings.success_message }}</p>
          {%- else -%}
            <div class="newsletter-signup__field-row">
              <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">
                {{ section.settings.input_placeholder }}
              </label>
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail-{{ section.id }}"
                class="newsletter-signup__input"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section.settings.input_placeholder }}"
                required
              >
              <button type="submit" class="newsletter-signup__button">
                {{ section.settings.button_label }}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="newsletter-signup__error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side image (desktop/tablet only)"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (used if no logo image)",
      "default": "I AM BITCH"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign up for our newsletter to be the first to know when we launch."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Email input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! You're on the list."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "logo_padding_top",
      "label": "Logo — top spacing",
      "min": 0,
      "max": 300,
      "step": 3,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "logo_margin_bottom",
      "label": "Logo — bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading — bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "subheading_margin_bottom",
      "label": "Subheading — bottom spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Email field — bottom spacing (gap to button)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#2f3e46"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
