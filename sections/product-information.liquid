  to   { opacity: 1; transform: scale(1); }
}

/* Default state: hidden until JS marks it in-view */
.product__area .animate-item {
  opacity: 0;
  will-change: opacity, transform;
}

.product__area .animate-item.in-view {
  animation-duration: var(--anim-duration, 600ms);
  animation-timing-function: var(--anim-easing, ease-out);
  animation-fill-mode: both;
}

.product__area[data-animate-style="fade"] .animate-item.in-view { animation-name: anim-fade; }
.product__area[data-animate-style="slide-up"] .animate-item.in-view { animation-name: anim-slide-up; }
.product__area[data-animate-style="slide-left"] .animate-item.in-view { animation-name: anim-slide-left; }
.product__area[data-animate-style="slide-right"] .animate-item.in-view { animation-name: anim-slide-right; }
.product__area[data-animate-style="zoom"] .animate-item.in-view { animation-name: anim-zoom; }

