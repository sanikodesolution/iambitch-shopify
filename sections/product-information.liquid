{% comment %}
  Product Information Section for Horizon Theme
  Section name: product-information
{% endcomment %}
{{ 'section-core.css' | asset_url | stylesheet_tag }}

{% comment %} ── Animation settings (theme-controllable) ── {% endcomment %}
{% assign anim_enabled = section.settings.enable_animations %}
{% assign anim_style = section.settings.animation_style %}
{% assign anim_duration = section.settings.animation_duration %}
{% assign anim_stagger = section.settings.animation_delay_stagger %}
{% assign anim_easing = section.settings.animation_easing %}

{% comment %} ── Social icon size (theme-controllable) ── {% endcomment %}
{% assign social_icon_size = section.settings.social_icon_size | default: 24 %}
{% assign social_icon_render_size = social_icon_size | times: 2 %}

<section
  class="product__area"
  data-animate-enabled="{{ anim_enabled }}"
  data-animate-style="{{ anim_style }}"
  style="--anim-duration: {{ anim_duration }}ms; --anim-delay-stagger: {{ anim_stagger }}ms; --anim-easing: {{ anim_easing }};"
>
  <!-- Social Icons - Left Side -->
<div class="product__social animate-item" data-animate-order="0">
  <a href="{{ section.settings.social_facebook }}" class="social__icon" target="_blank" aria-label="Facebook">
    {% if section.settings.social_facebook_icon %}
      <img src="{{ section.settings.social_facebook_icon | image_url: width: social_icon_render_size }}" alt="Facebook" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% else %}
      <img src="{{ 'facebook-02.svg' | asset_url }}" alt="Facebook" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% endif %}
  </a>

  <a href="{{ section.settings.social_twitter }}" class="social__icon" target="_blank" aria-label="Twitter/X">
    {% if section.settings.social_twitter_icon %}
      <img src="{{ section.settings.social_twitter_icon | image_url: width: social_icon_render_size }}" alt="Instagram" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% else %}
      <img src="{{ 'instagram.svg' | asset_url }}" alt="Instagram" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% endif %}
  </a>

  <a href="{{ section.settings.social_tiktok }}" class="social__icon" target="_blank" aria-label="TikTok">
    {% if section.settings.social_tiktok_icon %}
      <img src="{{ section.settings.social_tiktok_icon | image_url: width: social_icon_render_size }}" alt="TikTok" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% else %}
      <img src="{{ 'tiktok.svg' | asset_url }}" alt="TikTok" width="{{ social_icon_size }}" height="{{ social_icon_size }}" style="width: {{ social_icon_size }}px; height: {{ social_icon_size }}px;">
    {% endif %}
  </a>
</div>

  <div class="container">
    <div class="product__flex">
      <!-- Product Images - Left Side -->
      <div class="product__left">
        <div class="product__wrapper">
          <div class="product__image__container animate-item" data-animate-order="1">
            <div class="product__full__image">
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 700 }}" 
                  alt="{{ product.featured_image.alt }}"
                  id="mainProductImage"
                >
              {% endif %}
            </div>
          </div>

          <!-- Image Thumbnails — desktop grid / mobile slider -->
          <div class="product__thumb__wrapper animate-item" data-animate-order="2">
            <div class="product__image__thumb__track">
              <div class="product__image__thumb" id="thumbTrack">
                {% for image in product.images %}
                  <a href="#" class="product-thumb-link" data-src="{{ image | image_url: width: 700 }}" data-index="{{ forloop.index0 }}">
                    <img 
                      src="{{ image | image_url: width: 120 }}" 
                      alt="{{ image.alt }}"
                    >
                  </a>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Product Details - Right Side -->
      <div class="product__right">
        <div class="product__detail">
          <!-- Product Top Section -->
          <div class="product__detail__top animate-item" data-animate-order="1">
            
              <div class="product__tag">
                <svg width="16" height="16" viewBox="0 0 14 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6.09478 0.345482C6.24446 -0.115174 6.89616 -0.115172 7.04584 0.345483L8.25417 4.06433C8.32111 4.27034 8.51308 4.40982 8.7297 4.40982H12.6399C13.1243 4.40982 13.3257 5.02963 12.9338 5.31433L9.77037 7.6127C9.59513 7.74003 9.5218 7.96571 9.58874 8.17172L10.7971 11.8906C10.9467 12.3512 10.4195 12.7343 10.0276 12.4496L6.8642 10.1512C6.68896 10.0239 6.45166 10.0239 6.27642 10.1512L3.11298 12.4496C2.72112 12.7343 2.19388 12.3512 2.34356 11.8906L3.55189 8.17172C3.61882 7.96571 3.54549 7.74003 3.37025 7.6127L0.206808 5.31433C-0.185049 5.02963 0.0163404 4.40982 0.500702 4.40982H4.41093C4.62754 4.40982 4.81952 4.27034 4.88646 4.06433L6.09478 0.345482Z" fill="#B5D2E0"/>
                </svg>
                <span>BEST SELLER</span>
              </div>
            

            <h2>{{ product.title }}</h2>

            <div class="product__price">
              {% if product.compare_at_price %}
                <del>{{ product.compare_at_price | money }}</del>
              {% endif %}
              <span id="productPriceValue" data-unit-price="{{ product.selected_or_first_available_variant.price | default: product.price }}">{{ product.price | money }}</span>
            </div>

            <div class="product__rating">
              <ul>
                {% for i in (1..5) %}
                  <li>
                    <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7.69401 0.414556C7.87363 -0.138231 8.65567 -0.138231 8.83528 0.414556L10.3751 5.15357C10.4554 5.40078 10.6858 5.56816 10.9457 5.56816H15.9286C16.5098 5.56816 16.7515 6.31192 16.2813 6.65357L12.25 9.58243C12.0397 9.73522 11.9517 10.006 12.0321 10.2533L13.5719 14.9923C13.7515 15.5451 13.1188 16.0047 12.6486 15.6631L8.61732 12.7342C8.40703 12.5814 8.12227 12.5814 7.91198 12.7342L3.88073 15.6631C3.41051 16.0047 2.77782 15.5451 2.95743 14.9923L4.49723 10.2533C4.57755 10.006 4.48956 9.73522 4.27926 9.58243L0.248022 6.65357C-0.222206 6.31192 0.0194595 5.56816 0.600693 5.56816H5.58358C5.84352 5.56816 6.07389 5.40078 6.15422 5.15357L7.69401 0.414556Z" fill="#B2B192"/>
                    </svg>
                  </li>
                {% endfor %}
              </ul>
              <span class="rating__star">{{ section.settings.product_rating }}</span>
              <p>({{ product.reviews_count }} Reviews)</p>
            </div>
          </div>

          <!-- Color Selection -->
          {% if product.options_by_name['Color'] %}
            {% assign color_option_index = 0 %}
            {% for option in product.options %}
              {% if option == 'Color' %}
                {% assign color_option_index = forloop.index0 %}
              {% endif %}
            {% endfor %}

            {% assign reds_count = 0 %}
            {% assign pinks_count = 0 %}
            {% assign nudes_count = 0 %}
            {% assign purples_count = 0 %}
            {% assign blues_count = 0 %}

            {% assign red_keywords = 'red,scarlet,crimson,ruby,cherry,coral,tomato,rose,bordeaux,burgundy,wine,brick' | split: ',' %}
            {% assign pink_keywords = 'pink,blush,salmon,flamingo,fuchsia,magenta,rose,bubblegum,hot pink,baby pink,dusty pink' | split: ',' %}
            {% assign nude_keywords = 'nude,beige,sand,skin,natural,tan,caramel,latte,coffee,mocha,champagne,cream,ivory,bare,naked' | split: ',' %}
            {% assign purple_keywords = 'purple,violet,lavender,lilac,plum,mauve,grape,orchid,amethyst,mulberry,eggplant' | split: ',' %}
            {% assign blue_keywords = 'blue,navy,cobalt,teal,cerulean,sapphire,sky,denim,midnight,steel,powder,aqua,turquoise,indigo' | split: ',' %}

            {% for variant in product.variants %}
              {% assign color_name = variant.options[color_option_index] | downcase %}
              {% assign is_red = false %}
              {% for kw in red_keywords %}{% if color_name contains kw %}{% assign is_red = true %}{% endif %}{% endfor %}
              {% assign is_pink = false %}
              {% for kw in pink_keywords %}{% if color_name contains kw %}{% assign is_pink = true %}{% endif %}{% endfor %}
              {% assign is_nude = false %}
              {% for kw in nude_keywords %}{% if color_name contains kw %}{% assign is_nude = true %}{% endif %}{% endfor %}
              {% assign is_purple = false %}
              {% for kw in purple_keywords %}{% if color_name contains kw %}{% assign is_purple = true %}{% endif %}{% endfor %}
              {% assign is_blue = false %}
              {% for kw in blue_keywords %}{% if color_name contains kw %}{% assign is_blue = true %}{% endif %}{% endfor %}
              {% if is_red %}{% assign reds_count = reds_count | plus: 1 %}{% endif %}
              {% if is_pink %}{% assign pinks_count = pinks_count | plus: 1 %}{% endif %}
              {% if is_nude %}{% assign nudes_count = nudes_count | plus: 1 %}{% endif %}
              {% if is_purple %}{% assign purples_count = purples_count | plus: 1 %}{% endif %}
              {% if is_blue %}{% assign blues_count = blues_count | plus: 1 %}{% endif %}
            {% endfor %}

            <div class="product__color__selection animate-item" data-animate-order="2">
              <h3>Choose Color ({{ product.variants.size }} available)</h3>
              <div class="product__color__tablist">
                <button type="button" class="color-tab active" data-family="all">All</button>
                <button type="button" class="color-tab" data-family="reds">Reds ({{ reds_count }})</button>
                <button type="button" class="color-tab" data-family="pinks">Pinks ({{ pinks_count }})</button>
                <button type="button" class="color-tab" data-family="nudes">Nudes ({{ nudes_count }})</button>
                <button type="button" class="color-tab" data-family="purples">Purples ({{ purples_count }})</button>
                <button type="button" class="color-tab" data-family="blues">Blues ({{ blues_count }})</button>
              </div>
              <div class="porduct__tab__content">
                <div class="product__color__container">
                  <div class="all__color__container">
                    <ul id="colorSwatchList">
                      {% for variant in product.variants %}
                        {% assign color_val = variant.options[color_option_index] | downcase %}
                        {% assign v_families = '' %}
                        {% assign v_is_red = false %}
                        {% for kw in red_keywords %}{% if color_val contains kw %}{% assign v_is_red = true %}{% endif %}{% endfor %}
                        {% if v_is_red %}{% assign v_families = v_families | append: 'reds,' %}{% endif %}
                        {% assign v_is_pink = false %}
                        {% for kw in pink_keywords %}{% if color_val contains kw %}{% assign v_is_pink = true %}{% endif %}{% endfor %}
                        {% if v_is_pink %}{% assign v_families = v_families | append: 'pinks,' %}{% endif %}
                        {% assign v_is_nude = false %}
                        {% for kw in nude_keywords %}{% if color_val contains kw %}{% assign v_is_nude = true %}{% endif %}{% endfor %}
                        {% if v_is_nude %}{% assign v_families = v_families | append: 'nudes,' %}{% endif %}
                        {% assign v_is_purple = false %}
                        {% for kw in purple_keywords %}{% if color_val contains kw %}{% assign v_is_purple = true %}{% endif %}{% endfor %}
                        {% if v_is_purple %}{% assign v_families = v_families | append: 'purples,' %}{% endif %}
                        {% assign v_is_blue = false %}
                        {% for kw in blue_keywords %}{% if color_val contains kw %}{% assign v_is_blue = true %}{% endif %}{% endfor %}
                        {% if v_is_blue %}{% assign v_families = v_families | append: 'blues,' %}{% endif %}
                        {% assign swatch_color = variant.metafields.custom.swatch_color | default: variant.options[color_option_index] %}
                        <li 
                          class="color__fill" 
                          data-families="{{ v_families }}"
                          data-variant-id="{{ variant.id }}"
                          data-color-name="{{ variant.options[color_option_index] | escape }}"
                          title="{{ variant.options[color_option_index] }}"
                        >
                          <label for="color-variant-{{ variant.id }}" style="background-color: {{ swatch_color }};"></label>
                          <input id="color-variant-{{ variant.id }}" type="radio" name="color-select" value="{{ variant.id }}">
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                  <a href="#" class="product__all__color" id="showAllColors">SHOW ALL</a>
                </div>
              </div>
            </div>
          {% endif %}

          <!-- Quantity and Add to Cart -->
          <form action="/cart/add" method="post" enctype="multipart/form-data">
            <div class="product__item__buy animate-item" data-animate-order="3">
              <div class="product__item__count">
                <button type="button" class="count-minus">
                  <svg width="12" height="3" viewBox="0 0 12 3" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.000429869 2.04799V-1.33514e-05H11.5204V2.04799H0.000429869Z" fill="#AFC1CA"/>
                  </svg>
                </button>
                <span class="item__count">1</span>
                <button type="button" class="count-plus">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.4401 5.69604V7.74404H7.74408V13.44H5.69608V7.74404H7.82013e-05V5.69604H5.69608V4.3869e-05H7.74408V5.69604H13.4401Z" fill="#AFC1CA"/>
                  </svg>
                </button>
              </div>
              <input type="hidden" name="quantity" class="quantity-input" value="1">
              <input type="hidden" name="id" class="variant-id-input" value="{{ product.selected_or_first_available_variant.id }}">
              <div class="product__buy">
                <button type="submit" class="add-to-cart-btn">{{ section.settings.add_to_cart_text }}</button>
              </div>

              <!-- Wishlist Button -->
              <div class="product__favourite">
                <button
                  type="button"
                  class="wishlist-btn"
                  id="wishlistBtn"
                  aria-label="Add to wishlist"
                  data-product-id="{{ product.id }}"
                  data-product-title="{{ product.title | escape }}"
                  data-product-price="{{ product.price }}"
                  data-product-image="{{ product.featured_image | image_url: width: 300 }}"
                  data-product-url="{{ product.url }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                >
                  <svg class="wish-icon-empty" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.001 4.52853C14.35 2.42 17.98 2.49 20.2426 4.75736C22.5053 7.02472 22.583 10.637 20.4786 12.993L11.9999 21.485L3.52138 12.993C1.41705 10.637 1.49571 7.01901 3.75736 4.75736C6.02157 2.49315 9.64519 2.41687 12.001 4.52853ZM18.827 6.1701C17.3279 4.66794 14.9076 4.60701 13.337 6.01687L12.0019 7.21524L10.6661 6.01781C9.09098 4.60597 6.67506 4.66808 5.17157 6.17157C3.68183 7.66131 3.60704 10.0473 4.97993 11.6232L11.9999 18.6543L19.0201 11.6232C20.3935 10.0467 20.319 7.66525 18.827 6.1701Z" fill="#AEC1CA"/>
                  </svg>
                  <svg class="wish-icon-filled" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none">
                    <path d="M12.001 4.52853C14.35 2.42 17.98 2.49 20.2426 4.75736C22.5053 7.02472 22.583 10.637 20.4786 12.993L11.9999 21.485L3.52138 12.993C1.41705 10.637 1.49571 7.01901 3.75736 4.75736C6.02157 2.49315 9.64519 2.41687 12.001 4.52853Z" fill="#ff4d6d"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Product Information Collapse Sections -->
            <div class="product__information animate-item" data-animate-order="4">
              <div class="product__collapse">
                <div class="product__feature collapse__button">
                  <button type="button">
                    <span>Features</span>
                    <div class="collapse__icon__toggle">
                      <div class="icon__plus">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 5V19.002" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M19.002 12.002H5" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                      <div class="icon__cross">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M15 5L5.00068 14.9993M14.9993 15L5 5.00071" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                    </div>
                  </button>
                  <div class="product__collapse__content">
                    <div class="product__feature__flex">
                      <ul>
  {% if section.settings.feature_1 %}
    <li>
      <img src="{{ 'time-04.svg' | asset_url }}" width="24" height="24" alt="Feature 1">
      <span>{{ section.settings.feature_1 }}</span>
    </li>
  {% endif %}

  {% if section.settings.feature_2 %}
    <li>
      <img src="{{ 'layer.svg' | asset_url }}" width="24px" height="24px" alt="Feature 2">
      <span>{{ section.settings.feature_2 }}</span>
    </li>
  {% endif %}

  {% if section.settings.feature_3 %}
    <li>
      <img src="{{ 'arrow-all-direction.svg' | asset_url }}" width="24px" height="24px" alt="Feature 3">
      <span>{{ section.settings.feature_3 }}</span>
    </li>
  {% endif %}

  {% if section.settings.feature_4 %}
    <li>
      <img src="{{ 'droplet.svg' | asset_url }}" width="24px" height="24px" alt="Feature 4">
      <span>{{ section.settings.feature_4 }}</span>
    </li>
  {% endif %}
</ul>
                    </div>
                  </div>
                </div>
              </div>

              <div class="product__collapse">
                <div class="product__detail__text collapse__button">
                  <button type="button">
                    <span>Details</span>
                    <div class="collapse__icon__toggle">
                      <div class="icon__plus">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 5V19.002" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M19.002 12.002H5" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                      <div class="icon__cross">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M15 5L5.00068 14.9993M14.9993 15L5 5.00071" stroke="#AFC1CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </div>
                    </div>
                  </button>
                  <div class="product__collapse__content">
                    <article class="product__detail__article">
                      {{ product.description }}
                    </article>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :root {
    --font: 'glory', sans-serif;
  }
  .product__area {
    font-family: var(--font);
    padding: 32px 0px 28px 0px;
    background-color: #04060B;
    letter-spacing: -1.6%;
    position: relative;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  ul { padding: 0; margin: 0; list-style: none; }

  .container {
    max-width: 1232px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  /* ── Social Icons ── */
  .product__social {
    position: fixed;
    left: 0;
    top: 40%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 0;
    background:#263D48;
    padding: 12px 8px;
    z-index: 10;
  }

  .social__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #263D48;

    transition: background .3s;
    text-decoration: none;
  }
  {% comment %} .social__icon:hover { background: #1A2530; }
  .social__icon svg { flex-shrink: 0; } {% endcomment %}

  /* ── Layout ── */
  .product__flex {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 50px;
  }

  .product__full__image img {
    width: 100%;
    transition: opacity .3s;
    object-fit: cover;
    height:697px;
  }

  .product__left { width: calc(50% - 25px); }
  .product__right { width: calc(50% - 25px); }

  .product__detail {
    position: sticky;
    top: 40px;
  }

  .product__wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .product__full__image {
    display: flex;
    min-height: 697px;
  }

  /* ── Badge ── */
  .product__tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1A5470;
    border-radius: 100px;
    padding: 6px 10px;
    text-transform: uppercase;
    color: #B5D2E0;
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    font-family:var(--font);
  }

  .product__detail__top {
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: start;
  }

  .product__detail__top .product__tag {
    margin-bottom: 16px;
  }

  .product__detail__top h2 {
    font-size: 32px;
    line-height: 1.2;
    font-weight: 600;
    color: #fff;
    font-family: var(--font);
    margin: 0;
  }

  /* ── Rating ── */
  .product__rating ul { display: flex; gap: 1px; }
  .product__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .product__rating .rating__star { font-size: 14px; line-height: 16px; color: #fff; font-weight: 600; font-family:var(--font);}
  .product__rating p { font-size: 14px; line-height: 16px; color: #AFC1CA; font-family:var(--font);}

  /* ── Price — 50px below title (same as ATC → Details) ── */
  .product__detail__top > .product__price {
    margin: 0;
    padding-top: 50px;
  }
  .product__price del { display: block; color: #686667; font-size: 14px; line-height: 16px; }
  .product__price span { font-size: 48px; line-height: 1.15; color: #fff; display: block; margin: 0; font-family: var(--font); }

  /* ── Color Selection ── */
  .product__color__selection { padding-top: 56px; }
