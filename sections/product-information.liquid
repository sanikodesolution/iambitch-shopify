/* ══════════════════════════════════════════
   THEME-CONTROLLABLE ENTRANCE ANIMATIONS
   Controlled via section settings:
   --anim-duration, --anim-delay-stagger, --anim-easing
   and [data-animate-style] / [data-animate-enabled]
   ══════════════════════════════════════════ */

@keyframes anim-fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes anim-slide-up {
  from { opacity: 0; transform: translateY(32px); }
  to   { opacity: 1; transform: translateY(0); }
