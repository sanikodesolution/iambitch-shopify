<script>
  /* Shop's money format string (e.g. "${{amount}}") used to render the
     live quantity-based price below in the same style as the rest of the store. */
  var horizonProductMoneyFormat = {{ shop.money_format | json }};

  /* Formats an amount in cents using the shop's money_format, same logic
     Shopify themes use for AJAX cart/price updates. */
  function horizonFormatMoney(cents, format) {
    if (typeof cents === 'string') cents = cents.replace('.', '');
    var value = '';
    var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
    var formatString = format || horizonProductMoneyFormat || '${{amount}}';

    function formatWithDelimiters(number, precision, thousands, decimal) {
      precision = (typeof precision == 'undefined') ? 2 : precision;
      thousands = (typeof thousands == 'undefined') ? ',' : thousands;
      decimal   = (typeof decimal == 'undefined') ? '.' : decimal;
      if (isNaN(number) || number == null) return 0;
      number = (number / 100.0).toFixed(precision);
      var parts = number.split('.'),
          dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands),
          centsPart = parts[1] ? decimal + parts[1] : '';
      return dollars + centsPart;
    }

    var match = formatString.match(placeholderRegex);
    var key = match ? match[1] : 'amount';

    switch (key) {
      case 'amount_no_decimals':
        value = formatWithDelimiters(cents, 0);
        break;
      case 'amount_with_comma_separator':
        value = formatWithDelimiters(cents, 2, '.', ',');
        break;
      case 'amount_no_decimals_with_comma_separator':
        value = formatWithDelimiters(cents, 0, '.', ',');
        break;
      default:
        value = formatWithDelimiters(cents, 2);
    }

    return formatString.replace(placeholderRegex, value);
  }

  /* ══════════════════════════════════════════
     FIX: এই সেকশনটি "dynamic product section" হিসেবে
     পেজ প্রথম লোডের পরেও (Section Rendering API / AJAX /
     quick-view ইত্যাদির মাধ্যমে) DOM-এ inject হতে পারে।
     আগের কোডে সবকিছু শুধু 'DOMContentLoaded' ইভেন্টের ভেতরে
     ছিল, যেটা পেজে একবারই ফায়ার হয়। ফলে dynamic ভাবে
     section লোড হলে এই স্ক্রিপ্ট আর রান হতো না এবং
     .animate-item (opacity:0) কখনো visible হতো না —
     তাই প্রোডাক্ট "দেখা যাচ্ছিল না"।

     সমাধান: পুরো ইনিশিয়ালাইজেশন লজিককে একটা ফাংশনে
     (initProductInformationSection) বের করা হয়েছে, যেটা:
       1) normal page load এ চলবে (DOMContentLoaded বা readyState চেক করে)
       2) Shopify section re-render ইভেন্টে আবার চলবে
       3) একটা safety-timeout ফলব্যাক থাকবে, যাতে কোনো কারণে
          animation JS না চললেও প্রোডাক্ট অন্তত visible থাকে।
     ডিজাইন/CSS/HTML কিছুই পরিবর্তন করা হয়নি — শুধু এই
     initialization টাইমিং ফিক্স করা হয়েছে।
     ══════════════════════════════════════════ */

  function initProductInformationSection(root) {
    root = root || document;

    // এই সেকশন আগে থেকেই init হয়ে থাকলে দ্বিতীয়বার init আটকাও
    const areaEl = root.classList && root.classList.contains('product__area')
      ? root
      : root.querySelector ? root.querySelector('.product__area') : null;

    if (areaEl && areaEl.dataset.jsInitDone === 'true') return;
    if (areaEl) areaEl.dataset.jsInitDone = 'true';

    // ══════════════════════════════════════════
    // COLOR MAP → HEX
    // ══════════════════════════════════════════
    const colorMap = {
      'red':'#FF0000','scarlet':'#FF2400','crimson':'#DC143C','ruby':'#9B111E',
      'cherry':'#DE3163','coral':'#FF6B6B','tomato':'#FF6347','bordeaux':'#5C0120',
      'burgundy':'#800020','wine':'#722F37','brick':'#CB4154',
      'pink':'#FFB6C1','blush':'#FFB7C5','salmon':'#FA8072','flamingo':'#FC8EAC',
      'fuchsia':'#FF77FF','magenta':'#FF00FF','bubblegum':'#FFC1CC','hot pink':'#FF69B4',
      'baby pink':'#F4C2C2','dusty pink':'#DCAE96','nude pink':'#C68B77','soft pink':'#FFD1DC',
      'nude':'#E8C4A0','beige':'#F5F5DC','sand':'#C2B280','skin':'#FFDBAC',
      'natural':'#D4A574','tan':'#D2B48C','caramel':'#C68642','latte':'#C09A6B',
      'coffee':'#6F4E37','mocha':'#967259','champagne':'#F7E7CE','cream':'#FFFDD0',
      'ivory':'#FFFFF0','bare':'#E8C4A0','naked':'#F2D2BD','nude beige':'#D4A96A',
      'milky white':'#F5F0EB',
      'purple':'#800080','violet':'#EE82EE','lavender':'#E6E6FA','lilac':'#C8A2C8',
      'plum':'#8E4585','mauve':'#E0B0FF','grape':'#6F2DA8','orchid':'#DA70D6',
      'amethyst':'#9966CC','mulberry':'#C54B8C','eggplant':'#614051',
      'blue':'#4169E1','navy':'#000080','cobalt':'#0047AB','teal':'#008080',
      'cerulean':'#007BA7','sapphire':'#0F52BA','sky':'#87CEEB','denim':'#1560BD',
      'midnight':'#191970','steel':'#4682B4','powder':'#B0E0E6','aqua':'#00FFFF',
      'turquoise':'#40E0D0','indigo':'#4B0082',
      'black':'#1A1A1A','white':'#FFFFFF','clear':'#E8E8E8','off white':'#FAF9F6',
      'pearl':'#F0EAD6','gold':'#FFD700','silver':'#C0C0C0','bronze':'#CD7F32','glitter':'#E8D5B7',
    };

    function resolveSwatchColor(colorName) {
      if (!colorName) return '#ccc';
      const lower = colorName.toLowerCase().trim();
      if (colorMap[lower]) return colorMap[lower];
      for (const [key, hex] of Object.entries(colorMap)) {
        if (lower.includes(key) || key.includes(lower)) return hex;
      }
      return lower;
    }

    root.querySelectorAll('#colorSwatchList .color__fill').forEach(sw => {
      sw.querySelector('label').style.backgroundColor = resolveSwatchColor(sw.dataset.colorName);
    });

    // ══════════════════════════════════════════
    // WISHLIST FIX — check BEFORE modifying
    // ══════════════════════════════════════════
    const wishlistBtn = root.querySelector('#wishlistBtn');

    if (wishlistBtn) {
      const productId = parseInt(wishlistBtn.dataset.productId);
      const WISH_KEY  = 'shopify_wishlist';

      function getWishlist() {
        try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch(e) { return []; }
      }

      function saveWishlist(list) {
        try { localStorage.setItem(WISH_KEY, JSON.stringify(list)); } catch(e) {}
        const ev = new CustomEvent('wishlist:updated', { detail: { wishlist: list } });
        document.dispatchEvent(ev);
        window.dispatchEvent(ev);
      }

      function isWishlisted() {
        return getWishlist().some(item => item.id === productId);
      }

      function syncBtn() {
        const wishlisted = isWishlisted();
        wishlistBtn.classList.toggle('is-wishlisted', wishlisted);
        wishlistBtn.setAttribute('aria-label', wishlisted ? 'Remove from wishlist' : 'Add to wishlist');
      }

      // Set correct state on page load
      syncBtn();

      wishlistBtn.addEventListener('click', () => {
        // ✅ Check current state FIRST before any modification
        const currentlyWishlisted = isWishlisted();
        let list = getWishlist();

        if (currentlyWishlisted) {
          // Was in wishlist → remove it
          list = list.filter(item => item.id !== productId);

          if (window.CustomMenu) {
            window.CustomMenu.removeFromWishlist(productId);
          }
        } else {
          // Was not in wishlist → add it
          const product = {
            id:    productId,
            title: wishlistBtn.dataset.productTitle,
            price: parseInt(wishlistBtn.dataset.productPrice),
            image: wishlistBtn.dataset.productImage,
            url:   wishlistBtn.dataset.productUrl,
          };
          list.push(product);

          if (window.CustomMenu) {
            window.CustomMenu.addToWishlist(product);
          }
        }

        saveWishlist(list);
        // ✅ Sync button AFTER saving
        syncBtn();

        // small pop animation for feedback
        wishlistBtn.classList.remove('pop');
        void wishlistBtn.offsetWidth; // restart animation
        wishlistBtn.classList.add('pop');
      });
    }

    // ══════════════════════════════════════════
    // THUMBNAIL DRAG SLIDER (no arrows)
    // ══════════════════════════════════════════
    const track      = root.querySelector('#thumbTrack');
    const thumbLinks = track ? Array.from(track.querySelectorAll('.product-thumb-link')) : [];

    if (track) {
      // Make the track itself scrollable via CSS scroll on mobile
      // We'll use native scroll with drag support

      let isDragging  = false;
      let startX      = 0;
      let scrollStart = 0;
      let dragMoved   = false;

      // ── Touch events (mobile) ──
      track.addEventListener('touchstart', e => {
        startX      = e.touches[0].clientX;
        scrollStart = track.scrollLeft;
        dragMoved   = false;
      }, { passive: true });

      track.addEventListener('touchmove', e => {
        const dx = startX - e.touches[0].clientX;
        track.scrollLeft = scrollStart + dx;
        if (Math.abs(dx) > 5) dragMoved = true;
      }, { passive: true });

      // ── Mouse drag events (desktop / emulated) ──
      track.addEventListener('mousedown', e => {
        isDragging  = true;
        startX      = e.clientX;
        scrollStart = track.scrollLeft;
        dragMoved   = false;
        track.style.cursor = 'grabbing';
        e.preventDefault();
      });

      window.addEventListener('mousemove', e => {
        if (!isDragging) return;
        const dx = startX - e.clientX;
        track.scrollLeft = scrollStart + dx;
        if (Math.abs(dx) > 5) dragMoved = true;
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          track.style.cursor = 'grab';
        }
      });
    }

    // ══════════════════════════════════════════
    // THUMBNAIL GALLERY (main image swap)
    // ══════════════════════════════════════════
    const mainImage = root.querySelector('#mainProductImage');

    thumbLinks.forEach((thumb, index) => {
      if (index === 0) thumb.classList.add('active');

      thumb.addEventListener('click', e => {
        e.preventDefault();
        // Don't swap if user was dragging
        if (track && Math.abs(track.scrollLeft - (track._scrollAtClick || 0)) > 5) return;

        const img = thumb.querySelector('img');
        thumbLinks.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');

        if (mainImage) {
          mainImage.style.opacity = '0';
          const changeImage = () => {
            mainImage.src = thumb.dataset.src || img.src;
            mainImage.alt = img.alt;
            mainImage.style.opacity = '1';
            mainImage.removeEventListener('transitionend', changeImage);
          };
          mainImage.addEventListener('transitionend', changeImage);
        }
      });

      // Record scroll position at mousedown so click handler can detect drag
      thumb.addEventListener('mousedown', () => {
        if (track) track._scrollAtClick = track.scrollLeft;
      });
    });

    // ══════════════════════════════════════════
    // QUANTITY COUNTER
    // ══════════════════════════════════════════
    const countEl       = root.querySelector('.item__count');
    const minusBtn      = root.querySelector('.count-minus');
    const plusBtn       = root.querySelector('.count-plus');
    const quantityInput = root.querySelector('.quantity-input');
    const priceValueEl  = root.querySelector('#productPriceValue');
    let count = 1;

    function bumpCount() {
      if (!countEl) return;
      countEl.classList.remove('bump');
      void countEl.offsetWidth;
      countEl.classList.add('bump');
    }

    function updateLivePrice(qty) {
      if (!priceValueEl) return;
      const unitPriceCents = parseInt(priceValueEl.dataset.unitPrice, 10) || 0;
      priceValueEl.textContent = horizonFormatMoney(unitPriceCents * qty, horizonProductMoneyFormat);
    }

    if (plusBtn) plusBtn.addEventListener('click', () => {
      count++; countEl.textContent = count; quantityInput.value = count; bumpCount(); updateLivePrice(count);
    });
    if (minusBtn) minusBtn.addEventListener('click', () => {
      if (count > 1) { count--; countEl.textContent = count; quantityInput.value = count; bumpCount(); updateLivePrice(count); }
    });

    // ══════════════════════════════════════════
    // AJAX ADD TO CART (no redirect)
    // ══════════════════════════════════════════
    const addToCartBtn = root.querySelector('.add-to-cart-btn');

    if (addToCartBtn) {
      addToCartBtn.addEventListener('click', async (e) => {
        e.preventDefault(); // form submit বন্ধ করো

        const variantId = root.querySelector('.variant-id-input')?.value;
        const quantity  = root.querySelector('.quantity-input')?.value || 1;

        if (!variantId) return;

        // বাটনে loading state দেখাও
        const originalText = addToCartBtn.textContent;
        addToCartBtn.textContent = 'Adding…';
        addToCartBtn.disabled = true;

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: parseInt(variantId),
              quantity: parseInt(quantity)
            })
          });

          if (!res.ok) throw new Error('Cart add failed');

          // Cart count আপডেট করো (theme এর bubble/count badge)
          const cartRes  = await fetch('/cart.js');
          const cartData = await cartRes.json();
          const itemCount = cartData.item_count;

          // Horizon theme এর cart count badge আপডেট
          document.querySelectorAll('[data-cart-count], .cart-count, .header-cart-count').forEach(el => {
            el.textContent = itemCount;
          });

          // Cart update event fire করো (theme এর cart drawer খুলতে পারে)
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartData } }));
          window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartData } }));

          // Success state
          addToCartBtn.textContent = 'Added ✓';
          setTimeout(() => {
            addToCartBtn.textContent = originalText;
            addToCartBtn.disabled = false;
          }, 2000);

        } catch (err) {
          console.error('Add to cart error:', err);
          addToCartBtn.textContent = 'Failed – Try Again';
          setTimeout(() => {
            addToCartBtn.textContent = originalText;
            addToCartBtn.disabled = false;
          }, 2000);
        }
      });
    }

    // ══════════════════════════════════════════
    // COLLAPSE
    // ══════════════════════════════════════════
    root.querySelectorAll('.collapse__button > button').forEach(button => {
      const parent  = button.parentElement;
      const content = parent.querySelector('.product__collapse__content');

      // Open all by default
      parent.classList.add('active');
      content.style.maxHeight = content.scrollHeight + 'px';

      button.addEventListener('click', () => {
        parent.classList.toggle('active');
        content.style.maxHeight = parent.classList.contains('active')
          ? content.scrollHeight + 'px' : '0px';
      });
    });

    // ══════════════════════════════════════════
    // COLOR SWATCH TABS
    // ══════════════════════════════════════════
    const tabs          = root.querySelectorAll('.color-tab');
    const swatches      = root.querySelectorAll('#colorSwatchList .color__fill');
    const VISIBLE_LIMIT = 9;
    let currentFamily   = 'all';
    let showingAll      = false;

    function getVisibleSwatches(family) {
      return Array.from(swatches).filter(sw =>
        family === 'all' ? true : (sw.dataset.families || '').includes(family)
      );
    }

    function renderSwatches(family, forceAll) {
      const matching = getVisibleSwatches(family);
      const showAll  = forceAll || matching.length <= VISIBLE_LIMIT;
      const limit    = showAll ? matching.length : VISIBLE_LIMIT;
      swatches.forEach(sw => sw.classList.add('hidden'));
      matching.slice(0, limit).forEach(sw => sw.classList.remove('hidden'));
      const showAllBtn = root.querySelector('#showAllColors');
      if (!showAllBtn) return;
      if (matching.length > VISIBLE_LIMIT && !showAll) {
        showAllBtn.style.display = 'inline'; showAllBtn.textContent = 'SHOW ALL';
      } else if (matching.length > VISIBLE_LIMIT && showAll) {
        showAllBtn.style.display = 'inline'; showAllBtn.textContent = 'SHOW LESS';
      } else {
        showAllBtn.style.display = 'none';
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentFamily = tab.dataset.family;
        showingAll    = false;
        renderSwatches(currentFamily, false);
      });
    });

    const showAllBtn = root.querySelector('#showAllColors');
    if (showAllBtn) {
      showAllBtn.addEventListener('click', e => {
        e.preventDefault();
        showingAll = !showingAll;
        renderSwatches(currentFamily, showingAll);
      });
    }

    renderSwatches('all', false);

    // ══════════════════════════════════════════
    // VARIANT SELECTION VIA SWATCH
    // ══════════════════════════════════════════
    const variantInput = root.querySelector('.variant-id-input');

    swatches.forEach(sw => {
      sw.querySelector('label').addEventListener('click', () => {
        swatches.forEach(s => s.querySelector('input').checked = false);
        const radio = sw.querySelector('input[type="radio"]');
        radio.checked = true;
        if (variantInput) variantInput.value = radio.value;
        if (wishlistBtn) wishlistBtn.dataset.variantId = radio.value;
      });
    });

    // ══════════════════════════════════════════
    // THEME-CONTROLLABLE SCROLL-REVEAL ANIMATIONS
    // Reads settings baked into the section via
    // data-animate-enabled / data-animate-style / --anim-delay-stagger
    // ══════════════════════════════════════════
    const productArea = areaEl || root.querySelector('.product__area');

    if (productArea) {
      const animEnabled = productArea.dataset.animateEnabled !== 'false';
      const animItems    = Array.from(productArea.querySelectorAll('.animate-item'));
      const staggerMs = parseInt(
        getComputedStyle(productArea).getPropertyValue('--anim-delay-stagger')
      ) || 0;

      if (animEnabled && animItems.length && 'IntersectionObserver' in window) {
        // Stagger delay per item based on its order group (image col vs detail col
        // animate together; items share order via data-animate-order)
        animItems.forEach((el, i) => {
          const order = parseInt(el.dataset.animateOrder || i, 10);
          el.style.animationDelay = (order * staggerMs) + 'ms';
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        animItems.forEach(el => observer.observe(el));

        // ── Safety fallback ──
        // যদি কোনো কারণে (layout/geometry quirk, iframe context,
        // অথবা সেকশন প্রথমেই viewport-এ থাকা সত্ত্বেও observer দেরি
        // করে ফায়ার করে) কিছু আইটেম observer মিস করে যায়, একটা
        // সময়সীমার পর জোর করে দেখিয়ে দাও — যাতে প্রোডাক্ট কখনো
        // চিরস্থায়ীভাবে অদৃশ্য না থাকে।
        setTimeout(() => {
          animItems.forEach(el => {
            if (!el.classList.contains('in-view')) el.classList.add('in-view');
          });
        }, (anim_stagger_safety_ms(staggerMs, animItems.length)));
      } else {
        // Animations disabled from theme settings (or no IO support): show immediately
        animItems.forEach(el => el.classList.add('in-view'));
      }
    }

    function anim_stagger_safety_ms(staggerMs, itemCount) {
      // মোট stagger delay + কিছুটা বাফার টাইম, সর্বনিম্ন ২৫০০ms
      return Math.max(2500, (staggerMs * itemCount) + 2000);
    }
  }

  // ── ১) সাধারণ পেজ লোডে ──
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initProductInformationSection(document));
  } else {
    // readyState ইতিমধ্যে 'interactive' বা 'complete' —
    // অর্থাৎ এই স্ক্রিপ্ট DOMContentLoaded এর পরে রান হচ্ছে
    // (dynamic injection এর ক্ষেত্রে এটাই ঘটে)। সাথে সাথে init করো।
    initProductInformationSection(document);
  }

  // ── ২) Shopify Section Rendering API দিয়ে সেকশন re-render/inject হলে ──
  document.addEventListener('shopify:section:load', (e) => {
    const scope = (e.target && e.target.querySelector) ? e.target : document;
    initProductInformationSection(scope);
  });

  // ── ৩) কোনো কারণে উপরের কোনোটাই না ধরলে (কাস্টম AJAX/quick-view),
  //       MutationObserver দিয়ে নতুন .product__area যোগ হওয়া মাত্র init করো ──
  const __productAreaWatcher = new MutationObserver((mutations) => {
    for (const m of mutations) {
      m.addedNodes && m.addedNodes.forEach(node => {
        if (node.nodeType !== 1) return;
        if (node.classList && node.classList.contains('product__area')) {
          initProductInformationSection(node);
        } else if (node.querySelector) {
          const found = node.querySelector('.product__area');
          if (found) initProductInformationSection(found);
        }
      });
    }
  });

  if (document.body) {
    __productAreaWatcher.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      __productAreaWatcher.observe(document.body, { childList: true, subtree: true });
    });
  }
</script>

